5;                                          // expect: 5
5.0;                                        // expect: 5
2.5;                                        // expect: 2.5
10 / 4;                                     // expect: 2.5
6 / 3;                                      // expect: 2
1.5 + 1.5;                                  // expect: 3
0.5 + 0.25;                                 // expect: 0.75
1000000 * 1000000;                          // expect: 1000000000000
-0;                                         // expect: 0
