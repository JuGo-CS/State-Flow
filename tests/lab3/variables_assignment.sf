x = 5;                                      // expect: 5
x;                                          // expect: 5
x + 1;                                      // expect: 6
x = x * 2;                                  // expect: 10
y = x = 3;                                  // expect: 3
x;                                          // expect: 3
y;                                          // expect: 3
x = "now a string";                         // expect: now a string
x + "!";                                    // expect: now a string!
x = nil;                                    // expect: nil
x;                                          // expect: nil
