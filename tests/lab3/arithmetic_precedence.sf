2 + 3 * 4;                                  // expect: 14
(2 + 3) * 4;                                // expect: 20
10 - 2 - 3;                                 // expect: 5
100 / 10 / 5;                               // expect: 2
2 * 3 + 4 * 5;                              // expect: 26
-2 * 3;                                     // expect: -6
1 - -2;                                     // expect: 3
