1 < 2;                                      // expect: true
2 < 1;                                      // expect: false
2 < 2;                                      // expect: false
2 <= 2;                                     // expect: true
3 > 2;                                      // expect: true
2 > 2;                                      // expect: false
2 >= 2;                                     // expect: true
1 >= 2;                                     // expect: false
-1 < 0;                                     // expect: true
1 + 1 <= 2;                                 // expect: true
